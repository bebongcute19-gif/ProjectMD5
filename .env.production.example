# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION FOR VPS DEPLOYMENT
# ============================================================================
# Copy this file to .env on your VPS and update all secrets before starting:
# cp .env.production.example .env

# PostgreSQL Production Credentials (Containerized)
POSTGRES_DB=postgres
POSTGRES_USER=nexus_admin
POSTGRES_PASSWORD=ChangeMe_StrongPostgresPassword2026!@#
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# RabbitMQ Production Credentials
RABBITMQ_DEFAULT_USER=nexus_rabbit
RABBITMQ_DEFAULT_PASS=ChangeMe_StrongRabbitMQPassword2026!@#
RABBITMQ_PORT=5672

# JWT Secret (Min 256 bits / 32 characters HMAC SHA-256)
JWT_SECRET=ChangeMe_super-production-secret-nexus-omnichannel-crypto-secure-key-2026-vps

# Internal Reverse Proxy Binding Ports (Bound to 127.0.0.1 on host)
GATEWAY_PORT=8080
FRONTEND_PORT=3000

# Rate Limit Threshold for API Gateway (set higher for k6 stress test)
RATE_LIMIT_MAX=10000
